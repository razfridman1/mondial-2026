# =====================================================================
# Mondial 2026 — Environment variables
# Copy this file to `.env.local` and fill in real values.
# =====================================================================

# --- Firebase (Web SDK) — from Firebase Console > Project Settings > Web App ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mondial-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mondial-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mondial-2026.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abc123
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

# --- Firebase Admin SDK (server only) ---
# From Firebase Console > Project Settings > Service accounts > Generate new private key
# Paste the FULL JSON as a single line (escape newlines as \n)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mondial-2026",...}

# --- Admin emails (whitelist for Super Admin) ---
ADMIN_EMAILS=raz.fridman1@gmail.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_TZ=Asia/Jerusalem

# --- AI Chat (Anthropic Claude) ---
# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Email reminders (Resend) ---
# Get a key at https://resend.com → API Keys; verify your sender domain first.
RESEND_API_KEY=re_...
MAIL_FROM=Mondial 2026 <reminders@your-domain.com>

# --- Cron secret (optional, shared with Vercel cron header) ---
CRON_SECRET=

# --- API-Football (real-time lineups & fixtures) ---
# Get a key at https://dashboard.api-football.com/  (free tier: 100 req/day)
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# --- footballdata.io (real betting odds, 1X2) ---
# Get a key at https://footballdata.io/signup (free tier: 1000 req/month)
FOOTBALLDATA_IO_API_KEY=
FOOTBALLDATA_IO_URL=https://footballdata.io/api/v1

